#!/usr/bin/python3
# Read docs/validate-intent-layer.md before reading this file.
# Validates intent layer nodes (CLAUDE.md) and offload files under a directory tree.
# Usage: validate-intent-layer [--json|--jsonl] [directory]  (defaults to .)

import argparse
import json
import pathlib
import re
import sys

# --- constants ---------------------------------------------------------------

_NAMING_JSON = (
    pathlib.Path(__file__).resolve().parent.parent
    / "skills/intent-layer/references/offload-naming.json"
)


def _load_naming():
    try:
        data = json.loads(_NAMING_JSON.read_text())
        return (
            re.compile(data["offload_name_regex"]),
            frozenset(data["blocklisted"]),
            frozenset(data.get("blocklisted_dirs", [])),
        )
    except (OSError, KeyError, re.error) as exc:
        print(
            f"validate-intent-layer: cannot load {_NAMING_JSON}: {exc}", file=sys.stderr
        )
        sys.exit(1)


OFFLOAD_NAME_RE, BLOCKLISTED, BLOCKLISTED_DIRS = _load_naming()


def _in_blocklisted_dir(path: pathlib.Path) -> bool:
    return any(part in BLOCKLISTED_DIRS for part in path.parts)


NODE_CAP = 1000
ROOT_CAP = 2000  # scan root's CLAUDE.md — LCA placement funnels shared facts into it
TOKEN_WARN_PCT = 90
MD_ICON = "●"
WARN_ICON = "⚠"
ERROR_ICON = "✖"
_E = "\033"
COLORS = {
    "RED": f"{_E}[0;31m",
    "YELLOW": f"{_E}[0;33m",
    "GREEN": f"{_E}[0;32m",
    "BOLD": f"{_E}[1m",
    "DIM": f"{_E}[2m",
    "RESET": f"{_E}[0m",
}
NO_COLORS = {k: "" for k in COLORS}

DOWNLINK_RE = re.compile(r"^\[([^\]]+)\]:\s*(\S+)(?:\s+[\"'(](.+?)[\"')])?$")
CLAUDE_MACHINERY_RE = re.compile(
    r"/(\.claude|[^/]*claude[^/]*)/(skills|agents|commands|hooks|plans|memory|plugins)/"
)

# --- helpers -----------------------------------------------------------------


def _tokens(path):
    try:
        chars = pathlib.Path(path).stat().st_size
    except OSError:
        return 0
    return chars * 10 // 35


def _is_project_root(target):
    # ROOT_CAP applies only to the true project root, not any scan root — the
    # validate hook runs from the edited node's own directory, which must not
    # inflate that node's cap. Walk up to the git root (or filesystem root)
    # looking for an ancestor node; finding one means target is a child node.
    if (target / ".git").exists():
        return True
    for cur in target.parents:
        if (cur / "CLAUDE.md").exists():
            return False
        if (cur / ".git").exists():
            return True
    return True


# --- validator ---------------------------------------------------------------


class Validator:
    def __init__(self, target, output_format, use_colors):
        self.target = pathlib.Path(target).resolve()
        self.is_project_root = _is_project_root(self.target)
        self.fmt = output_format
        self.c = COLORS if use_colors else NO_COLORS
        self.errors = 0
        self.warnings = 0
        self.visited = set()  # recursion guard for check_node
        self.seen = set()  # orphan-check input; resolved paths
        self.node_data = {}  # file -> render data (text mode)
        self.json_files = []
        self.json_orphans = []

    def _within_target(self, path):
        return path.is_relative_to(self.target)

    def check_node(self, file):
        file = pathlib.Path(file).resolve()
        # A symlink can resolve outside the scan root; that node belongs to
        # another tree, and paths here are reported relative to self.target.
        if not self._within_target(file) or file in self.visited:
            return
        self.visited.add(file)
        self.seen.add(file)

        is_claude = file.name == "CLAUDE.md"
        directory = file.parent
        rel = str(file.relative_to(self.target))
        basename = file.name
        tok = _tokens(file)
        cap = (
            ROOT_CAP
            if is_claude and directory == self.target and self.is_project_root
            else NODE_CAP
        )
        token_pct = tok * 100 // cap

        # Phase 1: collect issues
        issues = []
        content = file.read_text(errors="replace")

        if not re.search(r"^# ", content, re.MULTILINE):
            self.errors += 1
            issues.append(("error", "missing H1 heading"))
        if not re.search(r"^## Purpose & Scope", content, re.MULTILINE):
            self.errors += 1
            issues.append(("error", "missing '## Purpose & Scope' section"))

        if is_claude:
            if directory == self.target and (directory / "AGENTS.md").exists():
                self.errors += 1
                issues.append(("error", "AGENTS.md coexists at project root"))
            if tok > cap:
                self.errors += 1
                issues.append(("error", f"~{tok} tokens — exceeds {cap:,} token cap"))
            elif token_pct >= TOKEN_WARN_PCT:
                self.warnings += 1
                issues.append(
                    (
                        "warn",
                        f"~{tok} tokens — exceeds {TOKEN_WARN_PCT}%"
                        f" of the {cap:,} token cap",
                    )
                )
        else:
            if basename in BLOCKLISTED:
                self.errors += 1
                issues.append(
                    (
                        "error",
                        f"offload file uses reserved/generic name '{basename}'"
                        " — rename to ALL-CAPS topic-specific (e.g. MODULE-DETAILS.md)",
                    )
                )
            elif not OFFLOAD_NAME_RE.match(basename):
                self.errors += 1
                issues.append(
                    (
                        "error",
                        f"offload file name '{basename}' must be ALL-CAPS,"
                        " hyphen-separated (e.g. MODULE-DETAILS.md)",
                    )
                )

        # Phase 2: scan downlinks, collect children
        children = []  # offload .md files (tree children)
        node_children = []  # CLAUDE.md files (independent nodes)
        in_downlinks = False

        for line in content.splitlines():
            if line.startswith("## Downlinks"):
                in_downlinks = True
                continue
            elif in_downlinks and line.startswith("## "):
                in_downlinks = False

            if not in_downlinks:
                continue

            if not line.strip():
                continue

            m = DOWNLINK_RE.match(line)
            if not m:
                self.errors += 1
                issues.append(("error", f"invalid downlink line: {line}"))
                continue

            target_path, description = m.group(2), m.group(3)
            if not description:
                self.errors += 1
                issues.append(
                    ("error", f"downlink missing description: {line.strip()}")
                )

            if not target_path.endswith(".md"):
                self.warnings += 1
                issues.append(
                    ("warn", f"downlink target is not a .md file: {target_path}")
                )
                continue

            linked_file = (directory / target_path).resolve()
            if not linked_file.exists():
                self.errors += 1
                issues.append(("error", f"broken downlink: {target_path}"))
                continue

            if self._within_target(linked_file):
                self.seen.add(linked_file)
                if linked_file.name == "CLAUDE.md":
                    node_children.append(linked_file)
                else:
                    children.append(linked_file)

        all_children = sorted(
            children + node_children,
            key=lambda p: (0 if p.parent != directory else 1, p),
        )

        # Store for text rendering (deferred until after orphan detection)
        self.node_data[file] = {
            "is_claude": is_claude,
            "rel": rel,
            "basename": basename,
            "tok": tok,
            "token_pct": token_pct,
            "issues": issues,
            "all_children": all_children,
            "directory": directory,
        }

        # Emit json/jsonl immediately (not deferred)
        if self.fmt in ("json", "jsonl"):
            kind = "node" if is_claude else "offload"
            file_obj = {
                "path": rel,
                "kind": kind,
                "tokens": tok,
                "token_pct": token_pct,
                "issues": [{"level": lv, "message": msg} for lv, msg in issues],
            }
            if self.fmt == "jsonl":
                print(json.dumps(file_obj))
            else:
                self.json_files.append(file_obj)

        for child in all_children:
            self.check_node(child)

    def render_text_tree(self, file, connector, continuation, orphan_map):
        data = self.node_data[file]
        c = self.c
        is_claude = data["is_claude"]
        tok = data["tok"]
        directory = data["directory"]

        token_color = ""
        if is_claude and data["token_pct"] > 100:
            token_color = c["RED"]

        if is_claude:
            print(
                f"{connector}{c['BOLD']}{MD_ICON} {data['rel']}{c['RESET']}"
                f"  {token_color}{tok} tokens{c['RESET']}"
            )
        else:
            print(
                f"{connector}{MD_ICON} {data['basename']}"
                f"  {c['DIM']}{tok} tokens  (offload){c['RESET']}"
            )

        # Merge regular children and orphans, sort same-dir first then alpha
        regular = [(p, None) for p in data["all_children"]]
        orphans = [(p, r) for p, r in orphan_map.get(file, [])]
        all_items = sorted(
            regular + orphans,
            key=lambda x: (0 if x[0].parent != directory else 1, x[0]),
        )

        has_children = bool(all_items)
        issue_prefix = f"{continuation}│  " if has_children else f"{continuation}   "

        for level, msg in data["issues"]:
            if " — " in msg:
                pre, suf = msg.split(" — ", 1)
                suf = " — " + suf
            else:
                pre, suf = msg, ""
            if level == "error":
                print(f"{issue_prefix}{c['RED']}{ERROR_ICON} {pre}{c['RESET']}{suf}")
            else:
                print(f"{issue_prefix}{c['YELLOW']}{WARN_ICON} {pre}{c['RESET']}{suf}")

        n = len(all_items)
        for i, (item_path, reason) in enumerate(all_items, 1):
            is_last = i == n
            child_connector = f"{continuation}{'└─' if is_last else '├─'} "
            child_continuation = f"{continuation}{'   ' if is_last else '│  '}"
            if reason is None:
                self.render_text_tree(
                    item_path, child_connector, child_continuation, orphan_map
                )
            else:
                orphan_tok = _tokens(item_path)
                orphan_rel = str(item_path.relative_to(self.target))
                print(
                    f"{child_connector}{c['YELLOW']}{WARN_ICON} {orphan_rel}"
                    f"  {orphan_tok} tokens  ({reason}){c['RESET']}"
                )

    def orphan_check(self, claude_files):
        orphan_map = {}  # ancestor node file -> [(orphan_path, reason), ...]

        def find_ancestor(directory):
            for cur in (directory, *directory.parents):
                candidate = (cur / "CLAUDE.md").resolve()
                if candidate in self.node_data:
                    return candidate
            root = (self.target / "CLAUDE.md").resolve()
            return root if root in self.node_data else None

        def add_orphan(path, reason):
            self.warnings += 1
            # CLAUDE.md orphans: search from grandparent so the node doesn't
            # find itself as its own ancestor
            search_from = (
                path.parent.parent if path.name == "CLAUDE.md" else path.parent
            )
            ancestor = find_ancestor(search_from)
            if ancestor:
                orphan_map.setdefault(ancestor, []).append((path, reason))
            if self.fmt == "jsonl":
                print(
                    json.dumps(
                        {
                            "type": "orphan",
                            "path": str(path.relative_to(self.target)),
                            "message": reason,
                        }
                    )
                )
            elif self.fmt == "json":
                self.json_orphans.append(
                    {
                        "path": str(path.relative_to(self.target)),
                        "message": reason,
                    }
                )

        # Check for unreferenced CLAUDE.md nodes
        for f in claude_files:
            f = pathlib.Path(f).resolve()
            if not self._within_target(f) or f == self.target / "CLAUDE.md":
                continue
            directory = f.parent
            # .parents stops at the filesystem root; _within_target stops at
            # the scan target, which is the outermost node that can own f.
            ancestor = None
            for cur in directory.parents:
                if not self._within_target(cur):
                    break
                if (cur / "CLAUDE.md").exists():
                    ancestor = cur / "CLAUDE.md"
                    break

            if ancestor is None:
                add_orphan(f, "no ancestor CLAUDE.md found")
                continue

            ancestor_dir = ancestor.parent
            rel_from_ancestor = str(f.relative_to(ancestor_dir))
            dir_name_claude = f"{f.parent.name}/CLAUDE.md"
            # Only look in ## Downlinks — prose references carry no contract
            in_dl = False
            ancestor_downlinks = ""
            for line in ancestor.read_text(errors="replace").splitlines():
                if line.startswith("## Downlinks"):
                    in_dl = True
                    continue
                elif in_dl and line.startswith("## "):
                    break
                if in_dl:
                    ancestor_downlinks += line + "\n"
            if (
                rel_from_ancestor not in ancestor_downlinks
                and dir_name_claude not in ancestor_downlinks
            ):
                add_orphan(
                    f,
                    f"not referenced in {str(ancestor.relative_to(self.target))}",
                )

        # Check for unlinked offload-candidate .md files
        for md in sorted(self.target.rglob("*.md")):
            if md.name == "CLAUDE.md":
                continue
            # Filters are scoped to the scan target: a repo that merely sits
            # under ~/docs or ~/.claude must not have its own files skipped.
            rel_path = md.relative_to(self.target)
            if ".git" in rel_path.parts or ".claude" in rel_path.parts:
                continue
            if CLAUDE_MACHINERY_RE.search(f"/{rel_path}"):
                continue
            if _in_blocklisted_dir(rel_path):
                continue
            if md.name in BLOCKLISTED:
                continue
            if not OFFLOAD_NAME_RE.match(md.name):
                continue
            resolved = md.resolve()
            if self._within_target(resolved) and resolved not in self.seen:
                add_orphan(resolved, "not downlinked from any node")

        return orphan_map


# --- main --------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(
        prog="validate-intent-layer",
        description="Validates intent layer nodes (CLAUDE.md) and offload files"
        " under a directory tree. With no format flag, prints a tree with colors"
        " and a summary line. Exits 1 on any error, 0 on a clean pass.",
    )
    fmt = parser.add_mutually_exclusive_group()
    fmt.add_argument(
        "--json",
        dest="fmt",
        action="store_const",
        const="json",
        help="single JSON document emitted after all processing; use when you"
        " need the full result at once (scripting, AI tool calls)",
    )
    fmt.add_argument(
        "--jsonl",
        dest="fmt",
        action="store_const",
        const="jsonl",
        help="one JSON object per line, streamed as files are visited; use when"
        " processing incrementally or piping into jq",
    )
    parser.add_argument(
        "directory", nargs="?", default=".", help="directory to scan (default: .)"
    )
    parser.set_defaults(fmt="text")
    args = parser.parse_args()

    output_format = args.fmt
    target_path = pathlib.Path(args.directory).resolve()
    use_colors = output_format == "text" and sys.stdout.isatty()
    validator = Validator(str(target_path), output_format, use_colors)

    claude_files = sorted(
        f
        for f in target_path.rglob("CLAUDE.md")
        if ".git" not in f.relative_to(target_path).parts
        and not _in_blocklisted_dir(f.relative_to(target_path))
    )

    if not claude_files:
        print(f"No CLAUDE.md files found under {target_path}")
        sys.exit(1)

    if output_format == "jsonl":
        print(json.dumps({"type": "start", "target": str(target_path)}))

    for f in claude_files:
        validator.check_node(f)

    orphan_map = validator.orphan_check(claude_files)

    if output_format == "text":
        root = (target_path / "CLAUDE.md").resolve()
        validator.render_text_tree(root, "", "", orphan_map)

    errors = validator.errors
    warnings = validator.warnings
    pass_val = errors == 0
    c = COLORS if use_colors else NO_COLORS

    if output_format == "json":
        print(
            json.dumps(
                {
                    "target": str(target_path),
                    "summary": {
                        "pass": pass_val,
                        "errors": errors,
                        "warnings": warnings,
                    },
                    "files": validator.json_files,
                    "orphans": validator.json_orphans,
                }
            )
        )
    elif output_format == "jsonl":
        print(
            json.dumps(
                {
                    "type": "summary",
                    "pass": pass_val,
                    "errors": errors,
                    "warnings": warnings,
                }
            )
        )
    else:
        err_s = "" if errors == 1 else "s"
        warn_s = "" if warnings == 1 else "s"
        err_part = (
            f"{c['RED']}{errors} error{err_s}{c['RESET']}" if errors > 0 else "0 errors"
        )
        warn_part = (
            f"{c['YELLOW']}{warnings} warning{warn_s}{c['RESET']}"
            if warnings > 0
            else "0 warnings"
        )
        result_part = (
            f"{c['RED']}FAIL{c['RESET']}"
            if errors > 0
            else f"{c['GREEN']}PASS{c['RESET']}"
        )
        print(f"\n{err_part} · {warn_part} · {result_part}")

    sys.exit(1 if errors > 0 else 0)


if __name__ == "__main__":
    main()
