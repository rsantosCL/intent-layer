#!/usr/bin/env bash
# Lint staged files before commit.
# ShellCheck (sh):             POSIX scripts (#!/bin/sh)
# ShellCheck (bash) + bash -n: bash scripts (*.sh)
# ruff:                        Python files (bin/*)
# jq:                          JSON files (*.json)
# rumdl:                       Markdown files (*.md)

files=()
while IFS= read -r line; do
  files+=("$line")
done < <(git diff --cached --name-only --diff-filter=d)
(( ${#files[@]} == 0 )) && exit 0

rc=0
sh_files=()
bash_files=()
python_files=()
json_files=()
md_files=()

for f in "${files[@]}"; do
  case "$f" in
    bin/*) python_files+=("$f") ;;
    # Partition by shebang, not by filename: a POSIX script gets --shell=sh so
    # bashisms can't creep in, and renaming a script can't silently downgrade
    # its lint.
    *.sh)
      if head -n 1 "$f" | grep -q '^#!/bin/sh'; then
        sh_files+=("$f")
      else
        bash_files+=("$f")
      fi
      ;;
    *.json) json_files+=("$f") ;;
    *.md)  md_files+=("$f") ;;
  esac
done

if (( ${#sh_files[@]} > 0 )) && command -v shellcheck >/dev/null 2>&1; then
  shellcheck --shell=sh --severity=warning "${sh_files[@]}" || rc=1
fi

if (( ${#bash_files[@]} > 0 )) && command -v shellcheck >/dev/null 2>&1; then
  shellcheck --shell=bash --severity=warning "${bash_files[@]}" || rc=1
fi

for f in "${bash_files[@]}"; do
  bash -n "$f" 2>&1 || rc=1
done

if (( ${#python_files[@]} > 0 )) && command -v ruff >/dev/null 2>&1; then
  out=$(ruff check "${python_files[@]}" 2>&1)         || { printf '%s\n' "$out"; rc=1; }
  out=$(ruff format --check "${python_files[@]}" 2>&1) || { printf '%s\n' "$out"; rc=1; }
fi

if (( ${#json_files[@]} > 0 )) && command -v jq >/dev/null 2>&1; then
  for f in "${json_files[@]}"; do
    jq empty "$f" 2>&1 || { printf 'Invalid JSON: %s\n' "$f"; rc=1; }
  done
fi

if (( ${#md_files[@]} > 0 )) && command -v rumdl >/dev/null 2>&1; then
  out=$(rumdl check "${md_files[@]}" 2>&1) || { printf '%s\n' "$out"; rc=1; }
fi

exit $rc
